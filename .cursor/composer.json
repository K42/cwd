{
  "name": "cien-wladcy-demonow-kreator-postaci",
  "version": "1.0.0",
  "description": "Multiagentowy template dla Cursor do tworzenia kreatora postaci dla gry RPG Cień Władcy Demonów",
  "agents": [
    {
      "name": "architect",
      "role": "Projektowanie architektury i planowanie funkcjonalności",
      "rules": ".cursor/rules/architect.md",
      "outputs": ["ARCHITECTURE.md", "kryteria akceptacji"]
    },
    {
      "name": "develop", 
      "role": "Implementacja kodu według specyfikacji architekta",
      "rules": ".cursor/rules/develop.md",
      "outputs": ["kod źródłowy", "testy jednostkowe", "JSDoc"]
    },
    {
      "name": "code-review",
      "role": "Przegląd kodu, wyszukiwanie błędów i zapewnienie jakości",
      "rules": ".cursor/rules/code-review.md", 
      "outputs": ["komentarze przeglądu", "zatwierdzenia", "TODO listy"]
    },
    {
      "name": "documentation",
      "role": "Dokumentowanie funkcjonalności i utrzymywanie instrukcji",
      "rules": ".cursor/rules/documentation.md",
      "outputs": ["dokumentacja API", "mapowanie zasad", "instrukcje wdrożenia"]
    }
  ],
  "workflow": {
    "cycle": ["architect", "develop", "code-review", "documentation"],
    "feedback_loop": true,
    "parallel_execution": false
  },
  "project": {
    "game": "Cień Władcy Demonów",
    "type": "Kreator postaci",
    "tech_stack": ["HTML", "JavaScript", "Node.js"],
    "database": "none"
  }
}